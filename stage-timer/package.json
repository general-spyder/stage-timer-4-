{
  "name": "stage-timer",
  "productName": "Stage Timer",
  "version": "1.0.0",
  "description": "Stage Timer - countdown output for stage productions",
  "main": "main.js",
  "author": "Stage Timer",
  "license": "UNLICENSED",
  "scripts": {
    "start": "electron .",
    "fonts": "node scripts/get-fonts.js",
    "dist:win": "electron-builder --win nsis",
    "dist:mac": "electron-builder --mac dmg"
  },
  "dependencies": { "font-list": "^1.5.1" },
  "devDependencies": { "electron": "^31.7.7", "electron-builder": "^24.13.3" },
  "build": {
    "appId": "com.stagetimer.app",
    "productName": "Stage Timer",
    "files": ["main.js", "preload.js", "config.js", "renderer/**", "assets/**", "package.json"],
    "win": { "target": "nsis" },
    "mac": { "target": "dmg", "category": "public.app-category.productivity" },
    "nsis": { "oneClick": false, "allowToChangeInstallationDirectory": true, "perMachine": false }
  }
}
