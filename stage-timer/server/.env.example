# Copy to .env and fill in. Never commit .env.
PORT=8080
ADMIN_EMAIL=mystagetimer@gmail.com
GMAIL_USER=mystagetimer@gmail.com
# Google Account > Security > 2-Step Verification > App passwords
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx
# Secret for downloading the customer list: /admin/users.csv?key=...
ADMIN_KEY=change-me-to-a-long-random-string
# Update info shown in the app's "Updates" tab. Raise LATEST_VERSION to announce an update.
LATEST_VERSION=1.0.0
DOWNLOAD_URL=https://your-domain.com/download
RELEASE_NOTES=Bug fixes and improvements.
